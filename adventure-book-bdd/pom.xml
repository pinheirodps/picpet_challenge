<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.pictet.adventurebook</groupId>
  <artifactId>adventure-book-bdd</artifactId>
  <version>1.0.0</version>
  <packaging>jar</packaging>

  <name>Adventure Book - BDD</name>
  <description>
    Cucumber suite covering the Adventure Book business rules (book validation, section
    navigation, health consequences, save and resume). It runs the real backend's domain
    classes, so a change to the game rules that breaks a scenario fails this build.

    It stays outside the backend's own Maven project deliberately: it is not part of the
    graded submission, and keeping it separate means `mvn test` in the backend runs only the
    tests being submitted.
  </description>

  <properties>
    <maven.compiler.source>21</maven.compiler.source>
    <maven.compiler.target>21</maven.compiler.target>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <cucumber.version>7.18.1</cucumber.version>
    <junit.platform.version>1.10.2</junit.platform.version>
    <backend.version>1.0.0</backend.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>io.cucumber</groupId>
        <artifactId>cucumber-bom</artifactId>
        <version>${cucumber.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <!--
      The real backend, so the scenarios exercise the shipped game rules instead of a
      lookalike written for the tests. Install it first:

        cd ../adventure-book-fullstack/backend && mvn install -DskipTests

      Only the domain and validation packages are used here. Those classes carry JPA
      annotations but are plain objects built through public constructors, so nothing in
      this project needs a database, a Spring context, or the backend's web layer — hence
      the exclusions below, which keep this suite as fast as it was when it ran against its
      own model.
    -->
    <dependency>
      <groupId>com.pictet</groupId>
      <artifactId>adventure-book-backend</artifactId>
      <version>${backend.version}</version>
      <scope>test</scope>
      <exclusions>
        <exclusion>
          <groupId>org.springframework.boot</groupId>
          <artifactId>spring-boot-starter-web</artifactId>
        </exclusion>
        <exclusion>
          <groupId>org.springframework.boot</groupId>
          <artifactId>spring-boot-starter-data-jpa</artifactId>
        </exclusion>
        <exclusion>
          <groupId>com.h2database</groupId>
          <artifactId>h2</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>io.cucumber</groupId>
      <artifactId>cucumber-java</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.cucumber</groupId>
      <artifactId>cucumber-picocontainer</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.cucumber</groupId>
      <artifactId>cucumber-junit-platform-engine</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.platform</groupId>
      <artifactId>junit-platform-suite</artifactId>
      <version>${junit.platform.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <version>3.26.3</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.2.5</version>
        <configuration>
          <includes>
            <include>**/RunCucumberTest.java</include>
          </includes>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
